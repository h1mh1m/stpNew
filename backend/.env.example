# Backend Server Configuration
APP_PORT=8080
FRONTEND_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
PORT=5432
HOSTNAME=localhost
DBNAME=stp_circuit
DB_USER=postgres
PASSWORD=your_database_password
# Schema Migration Policy: explicit migrations (make migrate-up) are preferred.
# AUTO_MIGRATE is false by default. Set to true only for local dev prototyping.
AUTO_MIGRATE=false

# Authentication & Security
JWT=your_secure_customer_jwt_secret_at_least_32_chars
JWTADMIN=your_secure_admin_jwt_secret_at_least_32_chars
SECRET=your_email_verification_token_secret

# Third-party Integrations
RESEND_API=re_your_resend_api_key_placeholder
